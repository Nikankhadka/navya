{
  "name": "navya",
  "version": "0.1-develop",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "open-route": "npx uri-scheme open",
    "export:web": "node scripts/export-web.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "verify": "node scripts/verify-project.js",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --coverageThreshold='{\"global\":{\"lines\":50}}'",
    "ci:local": "npm run typecheck && npm run test -- --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "build:nutrition-catalog": "node scripts/build-nutrition-catalog.js",
    "smoke:web": "node scripts/verify-project.js --smoke-web",
    "visual:smoke": "node scripts/visual-smoke.js",
    "seed:tester": "node scripts/prepare-tester-seed.js",
    "validate:tester": "node scripts/prepare-tester-validation.js",
    "dev": "concurrently -n db,expo -c blue,green \"npx supabase start\" \"npm start\"",
    "db:reset": "npx supabase db reset && npx supabase gen types typescript --local > src/types/database.ts",
    "db:stop": "npx supabase stop",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.10.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@expo/metro-runtime": "55.0.6",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.99.1",
    "@tamagui/babel-plugin": "^2.0.0-rc.41",
    "@tamagui/config": "^2.0.0-rc.41",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~55.0.5",
    "expo-apple-authentication": "^55.0.8",
    "expo-auth-session": "^55.0.8",
    "expo-constants": "^55.0.7",
    "expo-crypto": "^55.0.9",
    "expo-font": "^55.0.4",
    "expo-linear-gradient": "~55.0.8",
    "expo-linking": "^55.0.7",
    "expo-notifications": "~55.0.12",
    "expo-router": "~55.0.5",
    "expo-secure-store": "^55.0.8",
    "expo-splash-screen": "^55.0.10",
    "expo-sqlite": "^55.0.15",
    "expo-status-bar": "~55.0.4",
    "expo-web-browser": "^55.0.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-reanimated": "^4.2.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.8.3",
    "tamagui": "^2.0.0-rc.41",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.2",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.1.2",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-expo": "^55.0.18",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "supabase": "^2.9.6",
    "typescript": "~5.9.2"
  },
  "private": true,
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
